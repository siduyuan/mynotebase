# ============================================================
# Notebase 环境变量配置示例
#
# 用法：复制为 .env 后在本地填写真实值
#   cp .env.example .env
#
# .env 已被 .gitignore 忽略，不会进入 git；
# config.yaml 作为应用默认模板（含占位值）正常入库。
# 真实密钥 / 口令 / 域名 / 端口请只写在 .env 中，不要写进 config.yaml。
# ============================================================

# ---------- 认证（敏感，务必在 .env 中设置，勿提交）----------

# 会话密钥（加密会话 cookie）。生成：
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTHENTICATION_SECRET_KEY=

# 登录口令（明文，启动时自动哈希）
AUTHENTICATION_PASSWORD=

# API 密钥（供 MCP / 脚本等外部集成）。生成：
#   python -c "import secrets; print(secrets.token_hex(32))"
# 留空则仅启用会话认证
AUTHENTICATION_API_KEY=

# 是否启用认证（true / false）
AUTHENTICATION_ENABLED=false

# ---------- 域名 / 对外地址 ----------

# 分享链接的公开域名（留空则跟随浏览器来源）
# 示例：https://notes.example.com
SHARE_PUBLIC_ORIGIN=

# ---------- 端口 / 监听 ----------

# HTTP 端口（Docker / run.py 使用；host/监听地址在 config.yaml 的 server 段）
PORT=8000

# ---------- 存储 ----------

# 笔记库目录
NOTES_DIR=./data

# 插件目录
PLUGINS_DIR=./plugins

# ---------- 界面 ----------

# 应用显示名
APP_NAME=Notebase

# 默认主题（themes/ 下 CSS 文件名，不含 .css）
DEFAULT_THEME=light

# 自动保存防抖（毫秒）
AUTOSAVE_DELAY_MS=1000

# ---------- MCP ----------

# 是否通过 /mcp 提供 MCP HTTP 服务（true / false）
MCP_ENABLED=false